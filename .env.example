# ============================================================
#  智能体平台 - 环境变量配置
#  复制此文件为 .env 并填入真实值
# ============================================================

# ---------- LLM 提供商（三选一）----------
# 可选值: openai | anthropic | ollama
LLM_PROVIDER=

# OpenAI / 兼容接口（如 DeepSeek、通义、Azure）
OPENAI_API_KEY=
OPENAI_BASE_URL=   # 改成代理地址即可切换模型厂商
OPENAI_MODEL=

# Anthropic Claude（选用时填写）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Ollama 本地模型（选用时填写，无需 key）
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ---------- 服务配置 ----------
HOST=
PORT=
DEBUG=

# ---------- RAG / 知识库 ----------
EMBEDDING_MODEL=
RERANKER_MODEL=

# ---------- 数据库 ----------
DB_PATH=
